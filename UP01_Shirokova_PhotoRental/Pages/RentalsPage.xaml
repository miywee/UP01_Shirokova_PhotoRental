<Page x:Class="UP01_Shirokova_PhotoRental.Pages.RentalsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP01_Shirokova_PhotoRental.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Управление заявками"
      Background="{DynamicResource WindowBackgroundBrush}"
      Loaded="Page_Loaded">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Управление заявками на аренду"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <WrapPanel Grid.Row="1" Margin="0,0,0,10">

            <StackPanel Width="230" Margin="0,0,12,0">
                <TextBlock Text="Техника"/>

                <ComboBox x:Name="EquipmentCombo"
          Background="White"
          Foreground="Black"
          ToolTip="Выберите технику">

                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"
                       Style="{x:Null}"
                       Foreground="Black"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>

                </ComboBox>

            </StackPanel>

            <StackPanel Width="220" Margin="0,0,12,0">
                <TextBlock Text="Арендатор"/>

                <ComboBox x:Name="RenterCombo"
                    Background="White"
                    Foreground="Black"
                    ToolTip="Выберите пользователя">

                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding FIO}"
                       Style="{x:Null}"
                       Foreground="Black"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>

                </ComboBox>

            </StackPanel>

            <StackPanel Width="145" Margin="0,0,12,0">
                <TextBlock Text="Дата начала"/>
                <DatePicker x:Name="StartDatePicker"/>
            </StackPanel>

            <StackPanel Width="145">
                <TextBlock Text="Дата окончания"/>
                <DatePicker x:Name="EndDatePicker"/>
            </StackPanel>
        </WrapPanel>

        <WrapPanel Grid.Row="2" Margin="0,0,0,12">
            <Button Content="Создать заявку"
                    Width="160"
                    Click="AddButton_Click"/>

            <Button Content="Обновить список"
                    Width="160"
                    Click="RefreshButton_Click"/>
        </WrapPanel>

        <DataGrid x:Name="RentalsGrid"
                  Grid.Row="3"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  ToolTip="Для изменения дважды нажмите на ячейку">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"
                                    Binding="{Binding ID}"
                                    IsReadOnly="True"
                                    Width="45"/>

                <DataGridTextColumn Header="Техника"
                                    Binding="{Binding Equipment.Name}"
                                    IsReadOnly="True"
                                    Width="2*"/>

                <DataGridTextColumn Header="Арендатор"
                                    Binding="{Binding Users.FIO}"
                                    IsReadOnly="True"
                                    Width="2*"/>

                <DataGridTextColumn Header="Начало"
                                    Binding="{Binding StartDate,
                                              StringFormat=dd.MM.yyyy}"
                                    Width="*"/>

                <DataGridTextColumn Header="Окончание"
                                    Binding="{Binding EndDate,
                                              StringFormat=dd.MM.yyyy}"
                                    Width="*"/>

                <DataGridTextColumn Header="Стоимость"
                                    Binding="{Binding TotalPrice}"
                                    Width="*"/>

                <DataGridTextColumn Header="Статус"
                                    Binding="{Binding Status}"
                                    Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <WrapPanel Grid.Row="4"
                   HorizontalAlignment="Center"
                   Margin="0,15,0,0">

            <Button Content="Сохранить изменения"
                    Width="190"
                    Click="SaveButton_Click"/>

            <Button Content="Удалить заявку"
                    Width="160"
                    Click="DeleteButton_Click"/>

            <Button Content="Назад"
                    Width="120"
                    Click="BackButton_Click"/>
        </WrapPanel>
    </Grid>
</Page>
