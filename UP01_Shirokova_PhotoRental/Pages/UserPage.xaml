<Page x:Class="UP01_Shirokova_PhotoRental.Pages.UserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP01_Shirokova_PhotoRental.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Каталог техники"
      Background="{DynamicResource WindowBackgroundBrush}"
      Loaded="Page_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Каталог фото- и видеотехники"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <WrapPanel Grid.Row="1"
                   Margin="0,0,0,15">

            <StackPanel Width="240" Margin="0,0,15,0">
                <TextBlock Text="Поиск техники"/>
                <TextBox x:Name="SearchTextBox"
                         ToolTip="Введите название или категорию"
                         TextChanged="FilterChanged"/>
            </StackPanel>

            <StackPanel Width="180" Margin="0,0,15,0">
                <TextBlock Text="Доступность"/>

                <ComboBox x:Name="AvailabilityComboBox"
                        Background="White"
                        Foreground="Black"
                        SelectionChanged="FilterChanged">

                    <ComboBoxItem>
                        <TextBlock Text="Все"
                        Style="{x:Null}"
                        Foreground="Black"/>
                    </ComboBoxItem>

                    <ComboBoxItem>
                        <TextBlock Text="Доступна"
                        Style="{x:Null}"
                        Foreground="Black"/>
                    </ComboBoxItem>

                    <ComboBoxItem>
                        <TextBlock Text="Недоступна"
                        Style="{x:Null}"
                        Foreground="Black"/>
                    </ComboBoxItem>

                </ComboBox>

            </StackPanel>

            <StackPanel Width="190">
                <TextBlock Text="Сортировка"/>

                <ComboBox x:Name="SortComboBox"
                        Background="White"
                        Foreground="Black"
                        SelectionChanged="FilterChanged">

                    <ComboBoxItem>
                        <TextBlock Text="По названию"
                        Style="{x:Null}"
                        Foreground="Black"/>
                    </ComboBoxItem>

                    <ComboBoxItem>
                        <TextBlock Text="Сначала дешевле"
                        Style="{x:Null}"
                        Foreground="Black"/>
                    </ComboBoxItem>

                    <ComboBoxItem>
                        <TextBlock Text="Сначала дороже"
                        Style="{x:Null}"
                        Foreground="Black"/>
                    </ComboBoxItem>

                </ComboBox>

            </StackPanel>
        </WrapPanel>

        <DataGrid x:Name="EquipmentGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserSortColumns="True"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  AlternatingRowBackground="#20808080">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Название"
                                    Binding="{Binding Name}"
                                    Width="2*"/>

                <DataGridTextColumn Header="Категория"
                                    Binding="{Binding Category}"
                                    Width="*"/>

                <DataGridTextColumn Header="Описание"
                                    Binding="{Binding Description}"
                                    Width="2*"/>

                <DataGridTextColumn Header="Цена за день"
                                    Binding="{Binding PricePerDay}"
                                    Width="*"/>

                <DataGridCheckBoxColumn Header="Доступна"
                                        Binding="{Binding IsAvailable}"
                                        Width="*"/>
            </DataGrid.Columns>
        </DataGrid>


        <StackPanel Grid.Row="3"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,15,0,0">

            <Button Content="Сменить пароль"
            Width="150"
            Click="ChangePassword_Click"/>

            <Button Content="Выйти из аккаунта"
            Width="180"
            Click="LogoutButton_Click"/>
        </StackPanel>

    </Grid>
</Page>
