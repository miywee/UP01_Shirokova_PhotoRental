<Page x:Class="UP01_Shirokova_PhotoRental.Pages.ChangePassPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP01_Shirokova_PhotoRental.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Смена пароля"
      Background="{DynamicResource WindowBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Width="440"
                Padding="30"
                Margin="20"
                CornerRadius="15"
                HorizontalAlignment="Center"
                Background="{DynamicResource PanelBackgroundBrush}">

            <StackPanel>
                <TextBlock Text="Смена пароля"
                           FontSize="25"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           Margin="0,0,0,25"/>

                <TextBlock Text="Текущий пароль"/>
                <PasswordBox x:Name="OldPasswordBox"
                             ToolTip="Введите действующий пароль"
                             Margin="0,8,0,18"/>

                <TextBlock Text="Новый пароль"/>
                <PasswordBox x:Name="NewPasswordBox"
                             ToolTip="Минимум 6 символов, английские буквы и цифра"
                             Margin="0,8,0,18"/>

                <TextBlock Text="Подтвердите новый пароль"/>
                <PasswordBox x:Name="ConfirmPasswordBox"
                             ToolTip="Повторите новый пароль"
                             Margin="0,8,0,25"/>

                <Button Content="Сохранить пароль"
                        Height="40"
                        Click="SavePassword_Click"/>

                <Button Content="Назад"
                        Height="40"
                        Margin="5,12,5,0"
                        Click="BackButton_Click"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Page>
