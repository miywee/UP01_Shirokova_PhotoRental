<Page x:Class="UP01_Shirokova_PhotoRental.Pages.DiagramPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP01_Shirokova_PhotoRental.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Диаграмма аренды"
      Background="{DynamicResource WindowBackgroundBrush}"
      Loaded="Page_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="30">

            <TextBlock
                Text="Аналитика аренды техники"
                FontSize="26"
                FontWeight="Bold"
                Margin="0,0,0,10"/>

            <TextBlock
                Text="Стоимость завершённых аренд по категориям"
                FontSize="16"
                Margin="0,0,0,20"/>

            <Border
                Background="{DynamicResource PanelBackgroundBrush}"
                Padding="20"
                CornerRadius="12">

                <StackPanel>

                    <TextBlock
                        x:Name="SummaryText"
                        FontSize="17"
                        FontWeight="SemiBold"/>

                    <StackPanel
                        x:Name="ChartPanel"
                        Margin="0,15,0,10"/>

                </StackPanel>
            </Border>

            <WrapPanel
                Margin="0,20,0,0"
                HorizontalAlignment="Center">

                <Button
                    Content="Обновить диаграмму"
                    Width="200"
                    Click="RefreshButton_Click"/>

                <Button
                    Content="Назад"
                    Width="120"
                    Click="BackButton_Click"/>

            </WrapPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
