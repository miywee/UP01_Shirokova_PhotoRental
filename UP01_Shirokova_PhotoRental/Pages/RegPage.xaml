<Page x:Class="UP01_Shirokova_PhotoRental.Pages.RegPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP01_Shirokova_PhotoRental.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Регистрация"
      Background="{DynamicResource WindowBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Border Width="440"
                Padding="25"
                Margin="20"
                CornerRadius="15"
                Background="{DynamicResource PanelBackgroundBrush}"
                HorizontalAlignment="Center">

            <StackPanel>

                <TextBlock Text="Регистрация"
                           FontSize="26"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           Margin="0,0,0,7"/>

                <TextBlock Text="Создайте аккаунт"
                           FontSize="14"
                           TextAlignment="Center"
                           Margin="0,0,0,20"/>

                <TextBlock Text="ФИО"/>
                <TextBox x:Name="FIOTextBox"
                         ToolTip="Введите фамилию, имя и отчество"
                         Margin="0,5,0,12"/>

                <TextBlock Text="Логин"/>
                <TextBox x:Name="LoginTextBox"
                         ToolTip="Придумайте уникальный логин"
                         Margin="0,5,0,12"/>

                <TextBlock Text="Пароль"/>
                <PasswordBox x:Name="PasswordInput"
                             ToolTip="Минимум 6 символов, английские буквы и цифра"
                             Margin="0,5,0,12"/>

                <TextBlock Text="Подтверждение пароля"/>
                <PasswordBox x:Name="ConfirmPasswordInput"
                             ToolTip="Повторите пароль"
                             Margin="0,5,0,18"/>

                <Button Content="Зарегистрироваться"
                        Height="40"
                        ToolTip="Создать аккаунт"
                        Click="RegisterButton_Click"/>

                <Button Content="Вернуться ко входу"
                        Height="40"
                        Margin="5,10,5,0"
                        ToolTip="Открыть страницу авторизации"
                        Click="BackButton_Click"/>

            </StackPanel>
        </Border>
    </ScrollViewer>

</Page>
