<Page x:Class="UP01_Shirokova_PhotoRental.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP01_Shirokova_PhotoRental.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Авторизация"
      Background="{DynamicResource WindowBackgroundBrush}">


    <ScrollViewer VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled">


        <Border Width="420"
                Padding="35"
                CornerRadius="15"
                Background="{DynamicResource PanelBackgroundBrush}"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,20,0,20">

            <StackPanel>

                <TextBlock Text="Добро пожаловать!"
                           FontSize="26"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           Margin="0,0,0,8"/>

                <TextBlock Text="Войдите в свой аккаунт"
                           FontSize="14"
                           TextAlignment="Center"
                           Margin="0,0,0,30"/>

                <TextBlock Text="Логин"
                           FontSize="14"
                           Margin="0,0,0,7"/>

                <TextBox x:Name="LoginTextBox"
                         ToolTip="Введите логин"
                         Margin="0,0,0,20"/>

                <TextBlock Text="Пароль"
                           FontSize="14"
                           Margin="0,0,0,7"/>

                <PasswordBox x:Name="PasswordInput"
                             ToolTip="Введите пароль"
                             Margin="0,0,0,25"/>

                <Button x:Name="LoginButton"
                        Content="Войти"
                        Height="40"
                        IsDefault="True"
                        Click="LoginButton_Click"
                        ToolTip="Войти в систему"/>


                <Button x:Name="RegisterButton"
                        Content="Регистрация"
                        Height="40"
                        Margin="5,10,5,0"
                        ToolTip="Создать новый аккаунт"
                        Click="RegisterButton_Click"/>


                <!-- Блок капчи -->
                <StackPanel x:Name="CaptchaPanel"
            Visibility="Collapsed"
            Margin="0,15,0,0">

                    <TextBlock Text="Подтвердите, что вы не робот"
               FontSize="15"
               FontWeight="Bold"
               TextAlignment="Center"
               Margin="0,0,0,10"/>

                    <TextBlock x:Name="CaptchaText"
               FontFamily="Consolas"
               FontSize="27"
               FontWeight="Bold"
               FontStyle="Italic"
               TextAlignment="Center"
               Background="{DynamicResource WindowBackgroundBrush}"
               Padding="10"
               Margin="0,0,0,10"/>

                    <TextBox x:Name="CaptchaInput"
             MaxLength="6"
             ToolTip="Введите символы с изображения"
             Margin="0,0,0,10"/>

                    <Button Content="Проверить капчу"
            Click="CheckCaptcha_Click"
            ToolTip="Подтвердить введённый код"/>

                    <Button Content="Обновить код"
            Click="RefreshCaptcha_Click"
            ToolTip="Сгенерировать новый код"/>

                </StackPanel>



            </StackPanel>
        </Border>
    </ScrollViewer>
</Page>
